{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bitcoinuniverse:block-20:inscribe-payload:v1",
  "title": "Bitcoin Universe Inscribe BLOCK-20 emitted payload",
  "description": "Shape-only schema for compact JSON emitted by the current Bitcoin Universe Inscribe BLOCK-20 writer. It does not define token state, indexer acceptance, or arithmetic semantics.",
  "oneOf": [
    {
      "title": "Deploy payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "op", "tick", "max", "lim"],
      "properties": {
        "p": { "const": "block-20" },
        "op": { "const": "deploy" },
        "tick": { "type": "string", "minLength": 1 },
        "max": { "type": "string" },
        "lim": { "type": "string" },
        "des": { "type": "string" }
      }
    },
    {
      "title": "Mint payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "op", "tick", "amt", "hash"],
      "properties": {
        "p": { "const": "block-20" },
        "op": { "const": "mint" },
        "tick": { "type": "string", "minLength": 1 },
        "amt": { "type": "string" },
        "hash": { "type": "string" }
      }
    },
    {
      "title": "Transfer payload",
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "op", "tick", "amt"],
      "properties": {
        "p": { "const": "block-20" },
        "op": { "const": "transfer" },
        "tick": { "type": "string", "minLength": 1 },
        "amt": { "type": "string" }
      }
    }
  ]
}
